# DS2API runtime
# Runtime listen port inside the app/container
PORT=5001
# Docker Compose host port (compose only; container still listens on PORT)
DS2API_HOST_PORT=6011
LOG_LEVEL=INFO

# Admin authentication
DS2API_ADMIN_KEY=change-me

# Config loading (choose one)
# 1) file-based config
DS2API_CONFIG_PATH=/app/config.json
# 2) inline JSON or Base64 JSON
# DS2API_CONFIG_JSON=
# 3) legacy compatibility alias
# CONFIG_JSON=

# Optional: static admin assets path
# DS2API_STATIC_ADMIN_DIR=/app/static/admin

# Optional: chat history storage path (default: data/chat_history.json, on Vercel: /tmp/chat_history.json)
# DS2API_CHAT_HISTORY_PATH=data/chat_history.json

# Optional: token usage ledger configuration
# DS2API_USAGE_LEDGER_PATH=data/usage_ledger.json
# DS2API_USAGE_LEDGER_FLUSH_MS=5000
# DS2API_USAGE_LEDGER_BACKFILL=true

# Muse provider (text chat + image/video media), served by the Python worker
# DS2API_MUSE_WORKER_URL=http://127.0.0.1:8765
# DS2API_MUSE_WORKER_SECRET=change-me          # must equal MUSE_WORKER_SECRET on the worker
# DS2API_MUSE_COOLDOWN_SECONDS=60              # account cooldown after an upstream 429
# DS2API_IMAGES_MAX_N=4                        # lower the per-call image ceiling
# DS2API_MEDIA_PUBLIC_BASE_URL=                # absolute base for url responses; unset derives from the request

# Muse worker process (set on the worker host, not in the gateway)
# MUSE_WORKER_DRIVER=engine                    # engine | mock
# MUSE_WORKER_SECRET=change-me
# MUSE_MEDIA_DIR=./data/muse_media             # blob + video job store (must survive restarts)
# MUSE_MEDIA_TTL_HOURS=24
# MUSE_MEDIA_MAX_BYTES=67108864
# MUSE_MEDIA_ALLOWED_HOSTS=muse.ai             # hosts allowed to serve generated media
# MUSE_MEDIA_BASE_URL=                         # set only if clients may reach the worker directly
# MUSE_IMAGE_TIMEOUT=240
# MUSE_IMAGE_MAX_N=4
# MUSE_IMAGE_MAX_BYTES=8388608
# MUSE_VIDEO_TIMEOUT=900
# MUSE_VIDEO_MAX_BYTES=67108864
# MUSE_REFERENCE_MAX_BYTES=16777216

